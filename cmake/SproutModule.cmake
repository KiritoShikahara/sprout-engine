function(_sprout_module_allowed_deps name out_var)
    if(name STREQUAL "core")
        set(allowed "")
    elseif(name STREQUAL "platform")
        set(allowed "core")
    elseif(name STREQUAL "reflection")
        set(allowed "core")
    elseif(name STREQUAL "serialization")
        set(allowed "core;reflection")
    elseif(name STREQUAL "scene")
        set(allowed "core;reflection;serialization")
    elseif(name STREQUAL "render")
        set(allowed "core;platform;asset")
    elseif(name STREQUAL "physics")
        set(allowed "core")
    elseif(name STREQUAL "animation")
        set(allowed "core;scene")
    elseif(name STREQUAL "audio")
        set(allowed "core;asset")
    elseif(name STREQUAL "input")
        set(allowed "core;platform")
    elseif(name STREQUAL "ui")
        set(allowed "core;render;input")
    elseif(name STREQUAL "diagnostics")
        set(allowed "core")
    elseif(name STREQUAL "asset")
        set(allowed "core;platform;serialization")
    elseif(name STREQUAL "editor_core")
        set(allowed "core;scene;serialization;asset;reflection")
    else()
        message(FATAL_ERROR "Sprout: 未知の内部モジュール '${name}' です")
    endif()
    set(${out_var} "${allowed}" PARENT_SCOPE)
endfunction()

function(sprout_add_module name)
    cmake_parse_arguments(ARG "" "" "DEPS" ${ARGN})
    _sprout_module_allowed_deps("${name}" allowed_deps)

    foreach(dep IN LISTS ARG_DEPS)
        if(dep STREQUAL name)
            message(FATAL_ERROR "Sprout: モジュール '${name}' は自分自身に依存できません")
        endif()
        if(NOT dep IN_LIST allowed_deps)
            message(FATAL_ERROR
                "Sprout: モジュール '${name}' は '${dep}' に依存できません（許可: ${allowed_deps}）")
        endif()
    endforeach()

    set(target "sprout_${name}")
    add_library(${target} STATIC ${ARG_UNPARSED_ARGUMENTS})
    add_library("sprout::${name}" ALIAS ${target})

    target_include_directories(${target} PUBLIC
        "${SPROUT_ROOT_DIR}/engine/include"
        "${SPROUT_GENERATED_DIR}")

    set(dep_targets "")
    foreach(dep IN LISTS ARG_DEPS)
        list(APPEND dep_targets "sprout::${dep}")
    endforeach()
    if(dep_targets)
        target_link_libraries(${target} PUBLIC ${dep_targets})
    endif()

    sprout_set_warnings(${target})
    if(SPROUT_ENABLE_ASAN)
        sprout_enable_asan(${target})
    endif()
    if(SPROUT_ENABLE_COVERAGE)
        sprout_enable_coverage(${target})
    endif()
endfunction()
