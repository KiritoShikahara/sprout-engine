vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO Nelarius/imnodes
    REF v0.5
    SHA512 dd468f1806b40e72b0cbce482fc3d7fa49513e958809bfa2f19ce4dcfa6ce22677646a908809b9d36ff37d4ef7bf3632e700dee8d0418f107ccabf7d79a2e1b1
    HEAD_REF master)

vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS
        -DIMNODES_EXAMPLES=OFF
        -DIMNODES_IMGUI_TARGET_NAME=imgui::imgui)

vcpkg_cmake_build()

file(INSTALL "${SOURCE_PATH}/imnodes.h" DESTINATION "${CURRENT_PACKAGES_DIR}/include")
file(GLOB IMNODES_RELEASE_LIBS "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/*.lib")
file(GLOB IMNODES_DEBUG_LIBS "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/*.lib")
if(IMNODES_RELEASE_LIBS)
    file(INSTALL ${IMNODES_RELEASE_LIBS} DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
endif()
if(IMNODES_DEBUG_LIBS)
    file(INSTALL ${IMNODES_DEBUG_LIBS} DESTINATION "${CURRENT_PACKAGES_DIR}/debug/lib")
endif()

vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE")
