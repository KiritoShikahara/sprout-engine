{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "SPROUT_BUILD_EDITOR": "ON",
        "SPROUT_BUILD_TESTS": "ON",
        "SPROUT_BUILD_SAMPLES": "ON",
        "SPROUT_BUILD_CLI": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "vs2022-debug",
      "displayName": "Visual Studio 2022 (x64, Debug)",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "ninja-msvc",
      "displayName": "Ninja + MSVC (x64, Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Visual Studio 2022, x64)",
      "inherits": "vs2022",
      "cacheVariables": {
        "SPROUT_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer (Visual Studio 2022, x64)",
      "inherits": "vs2022",
      "cacheVariables": {
        "SPROUT_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-debug",
      "configurePreset": "ninja-msvc"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci",
      "configuration": "Debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "asan-debug",
      "configurePreset": "asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-msvc-debug",
      "configurePreset": "ninja-msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-debug",
      "configurePreset": "asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
